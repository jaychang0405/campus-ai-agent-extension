# Copy to .env and fill in to exercise the real cloud providers.
# Never commit the real .env file.

# Primary: Azure AI Vision (Image Analysis - Read/OCR)
AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_VISION_KEY=

# Fallback: Azure OpenAI (GPT-4o / GPT-4o-mini vision deployment)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Optional / reference only (not part of the Microsoft stack)
ANTHROPIC_API_KEY=
