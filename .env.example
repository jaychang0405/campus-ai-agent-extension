# Copy to .env and fill in to exercise the real cloud providers.
# Never commit the real .env file.

# Primary: Azure AI Vision (Image Analysis - Read/OCR)
AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_VISION_KEY=

# Fallback: Azure OpenAI (GPT-4o / GPT-4o-mini vision deployment)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Optional: Claude models hosted in Microsoft Foundry — DOES count as
# Microsoft ecosystem (GA since July 2026). Requires an Azure subscription
# with real pay-as-you-go billing; student/free-trial subscriptions are not
# supported for this specific model family. See src/providers/claudeVision.js.
CLAUDE_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/anthropic
CLAUDE_FOUNDRY_API_KEY=
CLAUDE_FOUNDRY_DEPLOYMENT=claude-sonnet-5

# Optional / reference only — direct Anthropic API, NOT part of the
# Microsoft stack. Only useful for local accuracy comparisons.
ANTHROPIC_API_KEY=
